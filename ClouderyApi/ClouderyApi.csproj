<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NuGetAudit>false</NuGetAudit>
        <!-- 本项目属于云术工作室（Cloudery Studio）旗下产品，程序集元数据会进入 exe/dll 属性页 -->
        <Company>云术工作室 (Cloudery Studio)</Company>
        <Product>ClouderyApi</Product>
        <Authors>云术工作室 (Cloudery Studio)</Authors>
        <Copyright>Copyright 2023-2026 Cloudery Studio, All rights reserved.</Copyright>
        <!-- XML 文档注释：Swashbuckle 用它给 OpenAPI 的 operation / schema 填中文描述（见 Shared/OpenApi/ScforgePublicDocument.cs）。
             未注释的成员不阻断构建（1591/1572/1573/1574/1587 仅提示），本仓库以 -warnaserror 构建，故显式 NoWarn。 -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591;1572;1573;1574;1587</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ClouderyApi.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
        <PackageReference Include="Casdoor.AspNetCore" Version="1.16.0" />
        <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" ExcludeAssets="All" />
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
        <!-- 固定 3.1.x：4.x 起内置 SixLabors 许可证校验任务，Release 构建缺少 license key 会直接失败 -->
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <!-- Data Protection 密钥环可选落到 Redis（多实例共享会话密钥）；Redis:ConnectionString 留空时改用文件系统 -->
        <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.10" />
        <!-- 限流计数 / 在线人数 / 邮箱验证码的可选 Redis 后端：Redis:ConnectionString 留空时不建立任何连接（本地开发 / CI 零依赖） -->
        <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

</Project>
