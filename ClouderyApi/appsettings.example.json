{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DATABASE_HERE"
  },
  "Env": {
    "SCKEY_API_BASE": "API_HERE",
    "SCKEY_BEARER_TOKEN": "YOUR_TOKEN_HERE"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "https://localhost:5173",
      "https://localhost:5174",
      "http://127.0.0.1:5173",
      "https://127.0.0.1:5173",
      "https://mhop.cldery.com"
    ]
  },
  "Authorization": {
    "Admins": [
      "YOUR_CASDOOR_ID"
    ]
  },
  "Mhop": {
    "AppName": "MHOP 公益心理辅助平台",
    "AutoMigrate": true,
    "Seed": true,
    "Jwt": {
      "Secret": "change-me-in-production",
      "ExpireHours": 72
    },
    "Llm": {
      "BaseUrl": "",
      "ApiKey": "",
      "Model": "glm-4-flash"
    },
    "Smtp": {
      "Host": "",
      "Port": 465,
      "User": "",
      "Password": "",
      "From": "",
      "UseSsl": true
    },
    "Casdoor": {
      "Enabled": true,
      "RedirectUri": ""
    },
    "Storage": {
      "Provider": "local",
      "Oss": {
        "Endpoint": "oss-cn-hangzhou.aliyuncs.com",
        "Bucket": "YOUR_BUCKET",
        "AccessKeyId": "YOUR_ACCESS_KEY_ID",
        "AccessKeySecret": "YOUR_ACCESS_KEY_SECRET",
        "SecurityToken": "",
        "PublicBaseUrl": "https://YOUR_CDN_DOMAIN",
        "PublicRead": true,
        "Prefix": "mhop"
      }
    },
    "LekeHotline": "",
    "UploadDir": "uploads"
  }
}
