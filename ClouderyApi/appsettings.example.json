{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DATABASE_HERE"
  },
  "Env": {
    "SCKEY_API_BASE": "API_HERE",
    "SCKEY_BEARER_TOKEN": "YOUR_TOKEN_HERE"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "https://pt.cldery.com",
      "http://localhost:5173",
      "http://localhost:5174",
      "https://localhost:5173",
      "https://localhost:5174",
      "http://127.0.0.1:5173",
      "https://127.0.0.1:5173",
      "https://mhop.cldery.com"
    ]
  },
  "Authorization": {
    "Admins": [
      "YOUR_CASDOOR_ID"
    ]
  },
  "TrustedProxies": {
    "//": "生产在 Nginx / 负载均衡之后时必填，否则按 IP 的限流会把全站算作一个客户端。只填自己控制的代理，绝不要信任任意来源（否则可伪造 X-Forwarded-For 绕过限流）。直连部署或本地开发请保持为空。",
    "Proxies": [],
    "Networks": [],
    "TrustForwardedFor": true,
    "TrustForwardedProto": true,
    "TrustForwardedHost": false
  },
  "Redis": {
    "//": "可选的 Redis 后端，用于限流计数（IRateLimitStore）、在线人数（IOnlineTrackerStore）、邮箱验证码（IEmailCodeStore）与 Data Protection 密钥环。ConnectionString 留空 = 不接入：这几项各自走进程内 / 文件系统实现，本地开发 / CI / 集成测试零依赖。填上后限流计数与在线人数跨实例共享、重启不清零，验证码与 Cookie 密钥环也多实例一致。云 Redis 通常要 password=***,ssl=true，并建议 abortConnect=false：连不上时限流与在线人数降级为进程内计数（fail-open，不报 500），邮箱验证码则直接拒绝发送与校验（fail-closed）。",
    "ConnectionString": "",
    "KeyPrefix": "cloudery:"
  },
  "DataProtection": {
    "//": "Cookie 认证（Casdoor 登录）密钥环的存放目录。留空 = 内容根下的 keys/：容器里就是 /app/keys，而 1Panel 把宿主目录挂到 /app，所以容器重建不丢密钥、用户不会集体掉线（多实例仍需 Redis）。配了 Redis 时密钥环改存 Redis，本项被忽略。",
    "KeysDirectory": ""
  },
  "Llm": {
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "glm-4-flash",
    "TimeoutSeconds": 30
  },
  "Scforge": {
    "//": "SCForge 生存战争插件、模组资源平台。Storage:Provider=local 时，UploadDir 下的 public/ 会被静态托管为 /scforge/uploads/*，插件包放在私有目录里只能经下载接口获取。",
    "UploadDir": "scforge-uploads",
    "MaxPackageBytes": 67108864,
    "MaxImageBytes": 4194304,
    "MaxPageSize": 60,
    "AccessTokenSecret": "",
    "AccessTokenMinutes": 120,
    "Storage": {
      "//": "插件包与图片的存放位置：local=本机磁盘；oss=阿里云 OSS（图片公共读返回外链，插件包仍私有、经下载接口流出）。",
      "Provider": "local",
      "Oss": {
        "Endpoint": "oss-cn-hangzhou.aliyuncs.com",
        "Bucket": "YOUR_BUCKET",
        "AccessKeyId": "YOUR_ACCESS_KEY_ID",
        "AccessKeySecret": "YOUR_ACCESS_KEY_SECRET",
        "SecurityToken": "",
        "PublicBaseUrl": "https://YOUR_CDN_DOMAIN",
        "PublicRead": true,
        "Prefix": "scforge"
      }
    }
  },
  "Mhop": {
    "AppName": "MHOP 公益心理辅助平台",
    "AutoMigrate": true,
    "Seed": false,
    "SeedAdminPassword": "",
    "Jwt": {
      "Secret": "change-me-in-production",
      "ExpireHours": 72
    },
    "Llm": {
      "BaseUrl": "",
      "ApiKey": "",
      "Model": "glm-4-flash"
    },
    "Smtp": {
      "Host": "",
      "Port": 465,
      "User": "",
      "Password": "",
      "From": "",
      "UseSsl": true,
      "AllowInvalidCertificate": false
    },
    "Casdoor": {
      "Enabled": true,
      "RedirectUri": ""
    },
    "Storage": {
      "Provider": "local",
      "Oss": {
        "Endpoint": "oss-cn-hangzhou.aliyuncs.com",
        "Bucket": "YOUR_BUCKET",
        "AccessKeyId": "YOUR_ACCESS_KEY_ID",
        "AccessKeySecret": "YOUR_ACCESS_KEY_SECRET",
        "SecurityToken": "",
        "PublicBaseUrl": "https://YOUR_CDN_DOMAIN",
        "PublicRead": true,
        "Prefix": "mhop"
      }
    },
    "LekeHotline": "",
    "UploadDir": "uploads"
  }
}
